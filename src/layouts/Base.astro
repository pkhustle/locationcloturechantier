---
import '../styles/global.css';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  jsonLd?: unknown[];
}

const { title, description, path, noindex = false, jsonLd = [] } = Astro.props;
const canonical = SITE.url + (path === '/' ? '/' : path);
---

<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#16233f" />
    <link rel="preload" href="/fonts/GoogleSansFlex-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/TikTokSans-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/images/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Location de clôture de chantier au Québec" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}/images/og-image.jpg`} />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <span class="mark">▦</span>
          Clôture<span>Chantier</span>
        </a>
        <nav class="nav">
          <a href="/">Accueil</a>
          <a href="/#services">Services</a>
          <a href="/guides/prix-location-cloture-chantier">Prix</a>
          <a href="/guides/permis-municipal-cloture-chantier">Permis</a>
          <a href="/fournisseurs">Fournisseurs</a>
          <a href="/soumission">Soumission</a>
        </nav>
        <a class="header-phone" href={`tel:${SITE.phone.replace(/[^0-9+]/g, '')}`}>
          <span class="ph-ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z"/></svg>
          </span>
          <span>
            <b>{SITE.phone}</b>
            <em>Appelez — soumission gratuite</em>
          </span>
        </a>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a class="brand" href="/"><span class="mark">▦</span> Clôture<span>Chantier</span></a>
            <p class="desc">Répertoire et guides indépendants sur la location de clôture de chantier partout au Québec. Comparez les fournisseurs, les prix et les règles de permis.</p>
          </div>
          <div>
            <h4>Liens rapides</h4>
            <ul>
              <li><a href="/">Accueil</a></li>
              <li><a href="/fournisseurs">Fournisseurs</a></li>
              <li><a href="/soumission">Demander une soumission</a></li>
              <li><a href="/politique-de-confidentialite">Confidentialité</a></li>
              <li><a href="/conditions-utilisation">Conditions</a></li>
            </ul>
          </div>
          <div>
            <h4>Guides</h4>
            <ul>
              <li><a href="/guides/prix-location-cloture-chantier">Prix de location</a></li>
              <li><a href="/guides/permis-municipal-cloture-chantier">Permis par ville</a></li>
              <li><a href="/#villes">Villes desservies</a></li>
            </ul>
          </div>
          <div>
            <h4>Contact</h4>
            <ul>
              <li>📞 <a href={`tel:${SITE.phone.replace(/[^0-9+]/g, '')}`}>{SITE.phone}</a></li>
              <li>✉️ <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
              <li>📍 Québec, Canada</li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© 2026 {SITE.name}. Tous droits réservés.</span>
          <span>
            <a href="/politique-de-confidentialite">Confidentialité (Loi 25)</a> · 
            <a href="/conditions-utilisation">Conditions d'utilisation</a> · 
            Service de mise en relation indépendant
          </span>
        </div>
      </div>
    </footer>
  </body>
</html>
