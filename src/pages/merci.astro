---
import Base from '../layouts/Base.astro';
---

<Base
  title="Merci — votre demande a été envoyée"
  description="Votre demande de soumission a bien été reçue."
  path="/merci"
  noindex={true}
>
  <main class="container">
    <p class="eyebrow">Demande reçue</p>
    <h1>Merci ! Votre demande est envoyée.</h1>
    <p class="lede">
      Un fournisseur qui dessert votre secteur vous contactera sous peu. Pour une
      réponse plus rapide, appelez-nous directement.
    </p>
    <p><a class="btn" href="/">Retour à l'accueil</a></p>
  </main>
</Base>
