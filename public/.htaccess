RewriteEngine On

# 1. Custom 404 error page
ErrorDocument 404 /404.html

# 2. Block direct access to sensitive files
<FilesMatch "\.(db|sqlite|sqlite3|env|git|lock|log|sh)$">
  Require all denied
</FilesMatch>

# 3. Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 4. Cache-Control for static assets
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf|png|jpg|jpeg|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, s-maxage=600, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>

# 5. Route /api/soumission -> /api/soumission.php
RewriteRule ^api/soumission/?$ /api/soumission.php [L,QSA]

# 6. Route /admin/export.csv -> /admin/index.php?action=export
RewriteRule ^admin/export\.csv$ /admin/index.php?action=export [L,QSA]

# 7. Route /admin and /admin/* -> /admin/index.php
RewriteRule ^admin/?$ /admin/index.php [L,QSA]
RewriteRule ^admin/.*$ /admin/index.php [L,QSA]

# 8. Clean URLs: if request doesn't exist as a file or directory, check for .html or directory/index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]
